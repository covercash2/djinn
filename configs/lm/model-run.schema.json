{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ModelRun",
  "description": "The results of a model run",
  "type": "object",
  "required": [
    "model_config",
    "prompt",
    "run_config"
  ],
  "properties": {
    "model_config": {
      "$ref": "#/definitions/ModelConfig"
    },
    "prompt": {
      "type": "string"
    },
    "run_config": {
      "$ref": "#/definitions/RunConfig"
    }
  },
  "definitions": {
    "Device": {
      "description": "A enum of supported devices to run models on\n\nTurning this into a runtime device is the job of the `djinn-models` crate.",
      "type": "string",
      "enum": [
        "Cpu",
        "Cuda",
        "Metal"
      ]
    },
    "ModelArchitecture": {
      "description": "The variant of the model to be loaded.\n\n`qwen2_5_instruct` is Qwen2.5-Instruct in quantized GGUF form: an instruct model with native tool calling. The size (0.5B, 1.5B, ...) is chosen by the `repo_id` / `weights_file` in the model source.\n\n(Variants are deliberately not documented one by one: a doc comment on a variant makes the generated schema a `oneOf`, whose validation errors no longer list the valid names.)",
      "type": "string",
      "enum": [
        "qwen2_5_instruct"
      ]
    },
    "ModelConfig": {
      "description": "Configurations that are loaded on initialization of the model.",
      "type": "object",
      "required": [
        "model_source",
        "variant"
      ],
      "properties": {
        "device": {
          "description": "Device to run on. When omitted, the best device compiled into the build is used (CUDA or Metal if enabled, otherwise CPU).",
          "default": null,
          "anyOf": [
            {
              "$ref": "#/definitions/Device"
            },
            {
              "type": "null"
            }
          ]
        },
        "model_source": {
          "$ref": "#/definitions/ModelSource"
        },
        "variant": {
          "$ref": "#/definitions/ModelArchitecture"
        }
      }
    },
    "ModelSource": {
      "description": "Where to load the model from, either HuggingFaceHub or from the file system",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "hugging_face_hub"
          ],
          "properties": {
            "hugging_face_hub": {
              "type": "object",
              "required": [
                "revision"
              ],
              "properties": {
                "repo_id": {
                  "description": "Hub repository holding the weights. Defaults to the architecture's standard repository.",
                  "default": null,
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "revision": {
                  "type": "string"
                },
                "tokenizer_repo": {
                  "description": "Hub repository to take `tokenizer.json` from, when it is not in `repo_id` (GGUF repositories usually do not ship a usable tokenizer).",
                  "default": null,
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "weights_file": {
                  "description": "File to download from the repository (for GGUF models). Defaults to the architecture's standard file.",
                  "default": null,
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "files"
          ],
          "properties": {
            "files": {
              "type": "object",
              "required": [
                "tokenizer_file",
                "weight_files"
              ],
              "properties": {
                "tokenizer_file": {
                  "type": "string"
                },
                "weight_files": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "RunConfig": {
      "description": "Parameters to the model\n\nWhen the `clap` feature is enabled this struct also implements [`clap::Args`], so it can be embedded directly in a CLI command.",
      "type": "object",
      "properties": {
        "repeat_last_n": {
          "description": "Number of last tokens to consider for the repeat penalty.",
          "default": 64,
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "repeat_penalty": {
          "description": "Penalty applied to repeated tokens (1.0 = no penalty).",
          "default": 1.100000023841858,
          "type": "number",
          "format": "float"
        },
        "sample_len": {
          "description": "Number of tokens to generate.",
          "default": 100,
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "seed": {
          "description": "RNG seed for reproducible generation.",
          "default": 299792458,
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "temperature": {
          "description": "Sampling temperature (lower = more deterministic).",
          "default": 1e-7,
          "type": "number",
          "format": "double"
        },
        "top_p": {
          "description": "Nucleus sampling probability cutoff.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      }
    }
  }
}